/* locoder's look: near-black background, rounded outlines instead of filled
   panels, titles sitting in the borders, three greys for text, and the
   current mode's colour as the only accent (applied from app.py). Keep these
   in sync with locoder/display.py. */
$bg: #0d0d0d;
$fg: #e8e8e8;
$secondary: #a8a8a8;
$muted: #6a6a6a;
$faint: #3a3a3a;
$line: #2a2a2a;
$hover: #161616;
$selected: #1f1f1f;

Screen {
    layout: vertical;
    background: $bg;
}

#body {
    height: 1fr;
}

#main-column {
    width: 1fr;
    height: 100%;
}

#sidebar {
    width: 34;
    height: 100%;
    margin: 1 1 0 0;
    padding: 1 2;
    border: round $line;
    border-title-align: left;
    background: $bg;
    color: $secondary;
    /* Clip rather than re-wrap while the collapse animation narrows it. */
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: clip;
}

/* Ctrl+B / sidebar collapses it; the transcript takes the full width. */
Screen.sidebar-hidden #sidebar {
    display: none;
}

/* -- transcript ---------------------------------------------------------- */

ChatLog {
    height: 1fr;
    padding: 0 2;
    background: $bg;
    scrollbar-size-vertical: 1;
    scrollbar-color: $faint;
    scrollbar-color-hover: $muted;
    scrollbar-background: $bg;
}

/* Your message: a rounded outline titled "you". */
.msg-user {
    margin-top: 1;
    padding: 0 1;
    border: round $line;
    border-title-align: left;
    color: $fg;
}

/* One assistant turn: header, collapsed thought, tool lines, text, footer.
   Everything inside a turn is indented under the header. */
.turn-header {
    margin-top: 1;
}

.turn-thought {
    padding-left: 2;
    color: $muted;
}
.turn-thought:hover {
    color: $secondary;
    background: $hover;
}

.turn-tool {
    padding-left: 2;
    color: $secondary;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.turn-tool.expanded {
    text-wrap: wrap;
}
.turn-tool:hover {
    background: $hover;
}

.turn-text {
    padding-left: 2;
    margin: 1 0;
    color: $fg;
}
.turn-text.narration {
    margin: 0;
    color: #7a7a7a;
}

.turn-live {
    padding-left: 2;
    margin-bottom: 1;
    color: $muted;
}

.turn-footer {
    padding-left: 2;
    color: #505050;
    margin-bottom: 1;
}

.msg-status {
    padding-left: 2;
}

/* -- prompt box and its menus -------------------------------------------- */

/* A rounded outline in the mode's colour (set in app.py), with the mode in
   the top border and the model in the bottom border. */
#prompt-box {
    height: auto;
    margin: 0 2 1 2;
    padding: 0 1;
    border: round $line;
    border-title-align: left;
    border-subtitle-align: right;
    background: $bg;
}

ChatInput {
    height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: $bg;
    color: $fg;
}
ChatInput:focus {
    border: none;
    background: $bg;
    background-tint: transparent;
}
/* The theme gives the placeholder its own lighter background (a visible band). */
ChatInput > .input--placeholder, ChatInput > .input--suggestion {
    background: $bg;
}

/* The / and @ menus: rounded outlines just above the prompt box. */
#slash-popup, #file-popup {
    height: auto;
    max-height: 10;
    display: none;
    margin: 0 2;
    padding: 0 1;
    border: round $line;
    background: $bg;
    color: $secondary;
}

/* Every option list (menus, pickers): no fill, a subtle highlight row. */
OptionList {
    background: $bg;
    scrollbar-size-vertical: 1;
    scrollbar-color: $faint;
    scrollbar-background: $bg;
}
OptionList > .option-list--option {
    color: $secondary;
}
OptionList > .option-list--option-highlighted {
    background: $selected;
    color: $fg;
    text-style: bold;
}
OptionList:focus > .option-list--option-highlighted {
    background: $selected;
}
OptionList > .option-list--option-hover {
    background: $hover;
}
OptionList > .option-list--option-disabled {
    color: $muted;
}

/* -- bottom bar ----------------------------------------------------------- */

StatusBar {
    height: 1;
    dock: bottom;
    padding: 0 2;
    background: $bg;
    color: $muted;
}

/* -- home screen (empty conversation) --------------------------------------
   The logo + wordmark lockup and prompt box centred; no transcript, sidebar
   or status bar. */
#home-logo, #home-notice, #home-recent, #home-spacer, #home-footer {
    display: none;
}
Screen.home #chatlog, Screen.home #sidebar, Screen.home #statusbar {
    display: none;
}
Screen.home #main-column {
    align-horizontal: center;
}
/* Every home child is 76 wide: Textual centres the children as one block,
   so a single full-width child would pin them all to the left. */
Screen.home #home-logo {
    display: block;
    height: 1fr;
    width: 76;
    max-width: 100%;
    content-align: center bottom;
    margin-bottom: 2;
}
Screen.home #prompt-box {
    width: 76;
    max-width: 100%;
    margin: 0;
}
Screen.home #slash-popup, Screen.home #file-popup {
    width: 76;
    max-width: 100%;
    margin: 0;
}
Screen.home #home-notice {
    display: block;
    width: 76;
    max-width: 100%;
    height: auto;
    padding: 0 1;
}
Screen.home #home-spacer {
    display: block;
    width: 76;
    max-width: 100%;
    height: 1fr;
}

/* "continue where you left off": a tab row over a short list. */
Screen.home #home-recent {
    display: block;
    width: 76;
    max-width: 100%;
    height: auto;
    margin-top: 2;
    padding: 0 1;
}
/* Nothing to offer yet (brand-new install): no panel at all. */
Screen.home #home-recent.-empty {
    display: none;
}
#recent-tabs {
    height: 1;
    margin-bottom: 1;
}
#recent-title {
    width: 1fr;
}
.recent-tab {
    width: auto;
    margin-left: 2;
    color: $muted;
}
.recent-tab:hover {
    color: $secondary;
}
.recent-tab.-active {
    color: $fg;
    text-style: bold underline;
}
#recent-list {
    height: auto;
    max-height: 7;
    padding: 0;
    border: none;
    background: $bg;
}
#recent-list > .option-list--option-highlighted {
    background: $bg;
    text-style: none;
}
#recent-list:focus > .option-list--option-highlighted {
    background: $selected;
}
Screen.home #home-footer {
    display: block;
    dock: bottom;
    height: 1;
    padding: 0 2;
}

/* -- dialogs ---------------------------------------------------------------
   A rounded outline over a dimmed screen; the title sits in the top border
   (coloured from modals.py). */
ModalScreen {
    align: center middle;
    background: #000000 55%;
}
#confirm-box, #select-box, #settings-box, #help-box {
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: round $line;
    border-title-align: left;
    background: $bg;
}

Button {
    min-width: 10;
    margin-left: 1;
    padding: 0 2;
    background: $selected;
    color: $secondary;
    text-style: none;
}
Button:hover {
    background: #2a2a2a;
    color: $fg;
}
Button:focus {
    background: $fg;
    color: $bg;
    text-style: bold;
}

#confirm-box {
    width: 90%;
}
#confirm-warning {
    margin-bottom: 1;
}
#confirm-preview-box {
    height: auto;
    max-height: 22;
    padding: 0 1;
    border: round $line;
    background: $bg;
}
#confirm-buttons, #settings-buttons {
    height: auto;
    margin-top: 1;
    align: right middle;
}
#confirm-hint, #settings-hint {
    width: 1fr;
}

#select-box {
    width: 80%;
    height: 80%;
}
#select-filter {
    margin-bottom: 1;
    padding: 0 1;
    border: round $line;
    background: $bg;
    height: 3;
}
#select-filter:focus {
    background-tint: transparent;
}
#select-filter > .input--placeholder {
    background: $bg;
}
#select-list {
    height: 1fr;
}
#select-hint {
    margin-top: 1;
}

#settings-box {
    width: 72;
}
.field-label {
    color: $muted;
    margin-top: 1;
}
#settings-box Input, #settings-box Select {
    width: 100%;
}
#settings-box Input {
    padding: 0 1;
    background: $selected;
}
#settings-box Input:focus {
    background-tint: transparent;
}
.settings-pair {
    height: auto;
}
.settings-pair > Vertical {
    height: auto;
    width: 1fr;
}
.settings-pair > Vertical:first-of-type {
    margin-right: 2;
}
.settings-row {
    height: auto;
    align: left middle;
    margin-top: 1;
}
.settings-row Label {
    width: 1fr;
}
/* A one-line toggle instead of the default three-row block. */
Switch {
    height: 1;
    width: auto;
    border: none;
    padding: 0;
    background: $bg;
}
Switch:focus {
    border: none;
    background-tint: transparent;
}
Switch > .switch--slider {
    color: $faint;
    background: $selected;
}
Switch.-on > .switch--slider {
    color: $fg;
}
#settings-error {
    height: auto;
    margin-top: 1;
}

#help-box {
    width: 84;
    max-width: 95%;
}
