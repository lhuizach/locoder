    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3.857"
        android:scaleY="3.857"
        android:translateX="27"
        android:translateY="27">
        <path
            android:fillColor="#FF4A9EFF"
            android:fillType="evenOdd"
            android:pathData="M0,0 H14 V14 H9 V5 H0 Z M1,1 H2 V2 H1 Z M1,3 H2 V4 H1 Z" />
    </group>
</vector>
